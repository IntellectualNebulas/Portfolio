---
// src/pages/index.astro
import "../style/global.css"

import { AchievedQuali } from "../data/achieved";
import { ProjectedQuali } from "../data/projected";
import { Workexp } from "../data/workexp";

import GithubRepos from "../components/GithubRepos.astro";

const featured = AchievedQuali.filter((p) => p.featured);
---

<html lang="en">

	<head>
		
		<meta charset="utf-8" />
		<link rel="icon" href="/TabIcon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>My Portfolio!</title>

	</head>

	<body>

		<div class = "topbar">
			<div class = "center">
				<h1>Welcome!</h1>
			</div>
		</div>
		
		<br><br>

		<div class = "center">
			<div class = "box">
				<h1><center>About Me!</center></h1>
				<div class = "aboutme">
					<p>I am hoping to become a Graduate Apprentice in either
						 Software Development or AI & Data Science.<br> I have also sent my UCAS away to Glasgow Calie and UWS for Software Development and Computing.<br>
						As part of my FA Work Placement I am part of a 2 man team in
					    charge of replacing the existing paper based contracting system
					    with a modern, sleek alternative. <br>Through this experience I have created my
						first live project that will be regularly used and learned PHP, via PHP Storm & Laravel!</p>
				</div>
			</div>
		</div>

		<div class ="center">
			<div class = "box">
				<h2><center>Projected Computing-based Qualifications</center></h2>
					<div class = "center">
						<ul class = "qualigrid">
							{ProjectedQuali.map((ProjectedQuali) => (
								<li class = "qualiA">
									<p>{ProjectedQuali.title}</p>
									<p>{ProjectedQuali.org}</p>
									<p>{ProjectedQuali.details}</p>
									<small>{ProjectedQuali.period}</small>
								</li>
							))}
						</ul>
					</div>
			</div>
		</div>

		<div class ="center">
			<div class = "box">
				<h2><center>Achieved Computing-based Qualifications</center></h2>
					<div class = "center">
						<ul class = "qualigrid">
							{AchievedQuali.map((AchievedQuali) => (
								<li class = "qualiA">
									<p>{AchievedQuali.title}</p>
									<p>{AchievedQuali.org}</p>
									<p>{AchievedQuali.details}</p>
									<small>{AchievedQuali.period}</small>
								</li>
							))}
						</ul>
					</div>
			</div>
		</div>

		<div class ="center">
			<div class = "box">
				<h2><center>Work Experience</center></h2>
					<div class = "center">
						<ul class = "qualigrid">
							{Workexp.map((Workexp) => (
								<li class = "qualiA">
									<p>{Workexp.title}</p>
									<p>{Workexp.org}</p>
									<p>{Workexp.paid}</p>
									<small>{Workexp.period}</small>
								</li>
							))}
						</ul>
					</div>
			</div>
		</div>



		<div class ="center">
			<div class = "box">
				<h2><center>My Public Github Repositories</center></h2>
					<div class = "center">
						<GithubRepos/>
					</div>
			</div>
		</div>

		<div class = "center">
				<div class = "box">
					<h2><center>Get in Contact!</center></h2>
					<input type="button" onclick="location.href='https://github.com/IntellectualNebulas';" value="My Github" />					<br><br>
					<input type="button" onclick="location.href='https://www.linkedin.com/in/ciaran-bell-4b7007443/';" value="My Linkedin" />					<br><br>

			</div>
		</div>
		<br><br><br>

		<div class = "f">
			<p>© 2026 Ciaran Bell</p>
		</div>

	</body>
</html>
